DATABASE_URL="file:./prisma/dev.db"

# First SuperAdmin login, created on first `npm start`/`db:seed` if none exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# Required for the "Create Tenant" flow to actually provision a Railway
# project/service — without it, tenants stay in BLOCKED_NO_TOKEN status.
# https://railway.app/account/tokens
RAILWAY_API_TOKEN=
