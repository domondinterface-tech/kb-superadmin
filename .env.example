DATABASE_URL="file:./prisma/dev.db"

# First SuperAdmin login, created on first `npm start`/`db:seed` if none exists yet.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Admin"

# Required for the "Create Tenant" flow to actually provision a Railway
# project/service — without it, tenants stay in BLOCKED_NO_TOKEN status.
# https://railway.app/account/tokens
RAILWAY_API_TOKEN=

# Shared secret for server-to-server calls from kb-superadmin to each
# tenant's KB Books instance (currently just GET /api/superadmin/summary,
# used for the "Rezime Finansye" card on a tenant's detail page). Generate
# any long random string. This exact value must also be set as an
# environment variable of the same name on each tenant's Railway service —
# new tenants get it automatically at provisioning time via setVariables(),
# but existing tenants provisioned before this was added need it set by hand.
SUPERADMIN_API_KEY=
